[Unit]
Description=Gunicorn instance to serve Small Shop Inventory System
After=network.target

[Service]
User=ubuntu
Group=www-data
WorkingDirectory=/opt/inventory-system
Environment="PATH=/opt/inventory-system/venv/bin"
EnvironmentFile=/opt/inventory-system/.env
ExecStart=/opt/inventory-system/venv/bin/gunicorn \
    --workers 3 \
    --bind 127.0.0.1:5000 \
    --timeout 60 \
    --access-logfile /var/log/inventory/access.log \
    --error-logfile /var/log/inventory/error.log \
    wsgi:application

Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target

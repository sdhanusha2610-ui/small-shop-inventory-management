# =================================================================
# Small Shop Inventory Management System - Environment Variables
# Copy this file to .env for local development: cp .env.example .env
# =================================================================

# Flask Core
FLASK_ENV=development
SECRET_KEY=replace-with-a-random-secret-key-in-production
PORT=5000

# Database Configuration (MySQL / Amazon RDS)
# Leave DB_HOST blank to automatically use local SQLite during testing
DB_USER=admin
DB_PASSWORD=YourSecurePassword123!
DB_HOST=your-rds-endpoint.czxxxxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=3306
DB_NAME=inventory_db

# AWS Cloud Services
AWS_REGION=us-east-1
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:small-shop-low-stock-topic
ENABLE_SNS_ALERTS=true
